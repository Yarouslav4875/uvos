<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Слой 1: Базовый приборный фон M4200 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0B10" />
        </shape>
    </item>

    <!-- Слой 2: Вертикальный градиент сланца -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#141620"
                android:centerColor="#0C0D14"
                android:endColor="#08090E" />
        </shape>
    </item>

    <!-- Слой 3: Центральное круговое осциллографическое свечение -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:centerX="50%"
                android:centerY="46%"
                android:startColor="#1000E5FF"
                android:centerColor="#05FF3B30"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Слой 4: Внутренняя тактическая рамка с угловыми насечками -->
    <item
        android:left="16dp"
        android:top="40dp"
        android:right="16dp"
        android:bottom="80dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1A282D3D"
                android:dashWidth="8dp"
                android:dashGap="4dp" />
        </shape>
    </item>
</layer-list>
