<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#450A0A" />
            <stroke android:width="2dp" android:color="#E02020" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#350808" />
            <stroke android:width="1.5dp" android:color="#FF4D4D" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#200B0E" />
            <stroke android:width="1dp" android:color="#591419" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
