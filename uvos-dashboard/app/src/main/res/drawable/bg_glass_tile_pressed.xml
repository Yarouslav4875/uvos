<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Слой 1: Насыщенный алый неон при нажатии -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#77FF3B30" />
        </shape>
    </item>

    <!-- Слой 2: Тёмное стекло с ярким неоновым контуром -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:angle="315"
                android:centerColor="#E610121A"
                android:endColor="#F207080B"
                android:startColor="#D9282D40"
                android:type="linear" />
            <stroke
                android:width="1.8dp"
                android:color="#B3FF3B30" />
        </shape>
    </item>

    <!-- Слой 3: Усиленный зеркальный рефлекс -->
    <item
        android:bottom="48dp"
        android:left="8dp"
        android:right="8dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <gradient
                android:angle="0"
                android:centerColor="#60FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF" />
            <size android:height="1.2dp" />
        </shape>
    </item>
</layer-list>
