<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#242838" />
            <stroke android:width="2dp" android:color="#E2E4EC" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F2332" />
            <stroke android:width="1.5dp" android:color="#A0A5BC" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12141C" />
            <stroke android:width="1dp" android:color="#2A2E40" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
