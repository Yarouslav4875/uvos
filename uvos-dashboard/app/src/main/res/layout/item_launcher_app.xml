<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/bg_tile_clickable"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Иконка приложения -->
    <ImageView
        android:id="@+id/launcher_app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Icon"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/launcher_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/uvos_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/launcher_app_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/uvos_text_dim"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:ellipsize="middle"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Индикатор каналов -->
    <TextView
        android:id="@+id/launcher_app_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_button_secondary"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="0/13"
        android:textColor="@color/uvos_cyan"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <!-- Кнопка щитка приложения -->
    <TextView
        android:id="@+id/launcher_btn_shield"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:text="⚙"
        android:textColor="@color/uvos_primary"
        android:textSize="16sp" />
</LinearLayout>
