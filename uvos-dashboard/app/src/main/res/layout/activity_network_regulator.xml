<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uvos_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Шапка: компактный прибор расхода трафика к лимиту (DESIGN.md §7.3) -->
        <com.uvos.dashboard.GaugeView
            android:id="@+id/net_traffic_gauge"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="12dp"
            custom:isCompact="true"
            custom:minLabel="0"
            custom:maxLabel="ЛИМИТ"
            custom:title="ДНЕВНОЙ ТРАФИК" />

        <!-- Карточка 1: Режимы доступа в сеть -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_mode_title"
                android:textColor="@color/uvos_text_dim"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.uvos.dashboard.SegmentedControl
                android:id="@+id/net_mode_selector"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Карточка 2: Дневной лимит трафика -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_limit_title"
                android:textColor="@color/uvos_text_dim"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.uvos.dashboard.SliderView
                android:id="@+id/net_limit_slider"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Карточка 3: Белый список доменов -->
        <LinearLayout
            android:id="@+id/net_whitelist_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_whitelist_title"
                android:textColor="@color/uvos_text_dim"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/net_domains_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Поле добавления нового домена -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/net_domain_input"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit_text"
                    android:hint="@string/net_add_domain_hint"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/uvos_text"
                    android:textColorHint="@color/uvos_text_dim"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/net_btn_add_domain"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/net_add_button"
                    android:textColor="@color/uvos_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Карточка 4: Расписание и условия -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/net_schedule_title"
                    android:textColor="@color/uvos_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/net_charging_only"
                    android:textColor="@color/uvos_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.uvos.dashboard.ToggleView
                android:id="@+id/net_toggle_charging"
                android:layout_width="88dp"
                android:layout_height="44dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
