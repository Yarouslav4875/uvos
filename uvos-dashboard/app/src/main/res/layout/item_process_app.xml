<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Верхняя строка: Иконка, Имя + PID, Кнопки действий -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/process_item_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Process Icon"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/process_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram"
                android:textColor="@color/uvos_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/process_item_pid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="PID: 10428 • u0_a51"
                android:textColor="@color/uvos_text_dim"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Кнопка Щиток -->
        <TextView
            android:id="@+id/process_btn_shield"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="ЩИТОК"
            android:textColor="@color/uvos_text"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <!-- Кнопка Остановить -->
        <TextView
            android:id="@+id/process_btn_stop"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="СТОП"
            android:textColor="@color/uvos_red"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Нижняя строка: Автовставляемые чипы метрик -->
    <LinearLayout
        android:id="@+id/process_chips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_ram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_channel"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ОЗУ: 440 МБ"
            android:textColor="@color/uvos_text_dim"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/chip_cpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_channel"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="CPU: 8.4%"
            android:textColor="@color/uvos_text_dim"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/chip_net"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_channel"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="🌐 СЕТЬ"
            android:textColor="@color/uvos_text"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/chip_geo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_channel"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="📍 ГЕО"
            android:textColor="@color/uvos_amber"
            android:textSize="9.5sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>
