<?xml version="1.0" encoding="utf-8"?>
<!-- Строка канала щитка: название + статус + лампа (DESIGN.md §6.2, §3.7) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@color/uvos_tile">

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/uvos_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/channel_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textColor="@color/uvos_text_dim"
        android:textSize="14sp" />

    <com.uvos.dashboard.LampView
        android:id="@+id/channel_lamp"
        android:layout_width="24dp"
        android:layout_height="24dp" />
</LinearLayout>
