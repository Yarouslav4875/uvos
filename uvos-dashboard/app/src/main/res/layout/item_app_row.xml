<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_tile_clickable"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Иконка приложения (квадрат со скруглением 28%, DESIGN.md §3.13) -->
    <TextView
        android:id="@+id/app_icon_badge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:textColor="@color/uvos_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/uvos_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/app_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/uvos_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/app_open_channels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/uvos_text_dim"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="→"
        android:textColor="@color/uvos_text_dim"
        android:textSize="16sp" />
</LinearLayout>
