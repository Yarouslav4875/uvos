<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_margin="16dp"
    android:background="@drawable/bg_tile"
    android:orientation="horizontal">

    <!-- Красная вертикальная полоса 4dp по левому краю (DESIGN.md §3.9) -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/uvos_red" />

    <!-- Содержимое карточки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/revocation_title"
            android:textColor="@color/uvos_text_dim"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/uvos_text"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/revocation_cancel"
                android:textColor="@color/uvos_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_button_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/revocation_confirm"
                android:textColor="@color/uvos_red"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
