<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="2dp"
    android:paddingBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp">

        <ImageView
            android:id="@+id/slot_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_tile_clickable"
            android:padding="11dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/slot_empty_badge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_tile"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/uvos_text_dim"
            android:textSize="26sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/slot_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Приложение"
        android:textColor="@color/uvos_text"
        android:textSize="10.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
