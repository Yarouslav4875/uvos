<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- Шапка папки: Название + кнопка переименования + закрыть -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_sys_folder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/folder_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Папка"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/folder_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 приложений"
                android:textColor="@color/uvos_text_dim"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_rename_folder"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✏️"
            android:textSize="16sp"
            android:background="@drawable/bg_quick_actions_item"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_close_folder"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/uvos_text_dim"
            android:textSize="16sp"
            android:background="@drawable/bg_quick_actions_item"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/uvos_divider"
        android:layout_marginBottom="14dp" />

    <!-- Сетка приложений внутри папки (горизонтальные ряды или контейнер) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="280dp">

        <LinearLayout
            android:id="@+id/folder_apps_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/uvos_divider"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Нижняя панель действий папки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_folder_add_app"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_button_secondary"
            android:text="➕ Добавить"
            android:textColor="@color/uvos_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_folder_dissolve"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_secondary"
            android:text="🗑️ Расформировать"
            android:textColor="#FF8585"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
