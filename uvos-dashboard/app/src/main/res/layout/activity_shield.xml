<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uvos_background"
    android:orientation="vertical">

    <!-- Шапка-прибор ACCESS: сколько каналов открыто во всей системе (DESIGN.md §7.1) -->
    <com.uvos.dashboard.GaugeView
        android:id="@+id/shield_gauge"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_margin="16dp"
        custom:minLabel="0"
        custom:maxLabel="MAX"
        custom:title="ACCESS" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="ПРИЛОЖЕНИЯ (ЗАКРЫТАЯ ТЕРРИТОРИЯ)"
        android:textColor="@color/uvos_text_dim"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Список приложений -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/shield_apps_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btn_open_log"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/log_button"
            android:textColor="@color/uvos_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shield_demo_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="@string/shield_demo_note"
            android:textColor="@color/uvos_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
