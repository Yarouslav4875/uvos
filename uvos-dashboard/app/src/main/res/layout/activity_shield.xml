<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/uvos_background">

    <!-- Шапка-прибор ACCESS: сколько каналов открыто во всей системе -->
    <com.uvos.dashboard.GaugeView
        android:id="@+id/shield_gauge"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_margin="16dp"
        custom:minLabel="0"
        custom:maxLabel="13"
        custom:title="ACCESS"
        xmlns:custom="http://schemas.android.com/apk/res-auto" />

    <!-- Список каналов заполняется кодом (без RecyclerView - ноль зависимостей) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/shield_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <TextView
        android:id="@+id/shield_demo_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/uvos_text_dim"
        android:textSize="13sp"
        android:text="@string/shield_demo_note" />
</LinearLayout>
