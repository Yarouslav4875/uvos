<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uvos_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Сетка приборов 2x2 в авиационном стиле UnderVoltOS (DESIGN.md §3.1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="16dp">

            <!-- Прибор 1: BATT (Заряд батареи) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="8dp">

                <com.uvos.dashboard.GaugeView
                    android:id="@+id/gauge_battery"
                    android:layout_width="match_parent"
                    android:layout_height="164dp"
                    custom:minLabel="0%"
                    custom:maxLabel="100%"
                    custom:unit="%"
                    custom:title="BATT" />

                <!-- Внешняя плашка со значением (вынесена за пределы вольтметра) -->
                <TextView
                    android:id="@+id/val_battery_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tile"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="100% • 4.12V"
                    android:textColor="@color/uvos_text"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Прибор 2: TEMP (Температура батареи) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="8dp">

                <com.uvos.dashboard.GaugeView
                    android:id="@+id/gauge_temp"
                    android:layout_width="match_parent"
                    android:layout_height="164dp"
                    custom:minLabel="20°"
                    custom:maxLabel="50°"
                    custom:unit="°C"
                    custom:title="TEMP" />

                <!-- Внешняя плашка со значением (вынесена за пределы вольтметра) -->
                <TextView
                    android:id="@+id/val_temp_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tile"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="25.0°C • НОРМА"
                    android:textColor="@color/uvos_text"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Карточка профилей ограничений (CONTROL-SCHEME.md §4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_title"
                android:textColor="@color/uvos_text_dim"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <com.uvos.dashboard.SegmentedControl
                android:id="@+id/profile_selector"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/profile_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/uvos_text"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/demo_note_profiles"
                android:textColor="@color/uvos_text_dim"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Карточка суточного журнала попыток (DESIGN.md §7.4) -->
        <LinearLayout
            android:id="@+id/card_daily_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_tile_clickable"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.uvos.dashboard.LampView
                android:id="@+id/log_lamp_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                custom:isLampOn="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_counter_today"
                    android:textColor="@color/uvos_text_dim"
                    android:textSize="10.5sp"
                    android:letterSpacing="0.06"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/log_blocked_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/uvos_text"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="@color/uvos_text_dim"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Раздел Оболочки: Установленные приложения (Launcher) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ПРИЛОЖЕНИЯ (ОБОЛОЧКА)"
                    android:textColor="@color/uvos_text_dim"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/launcher_apps_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/uvos_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="Нажмите для запуска • Шестерёнка справа для управления 13 каналами"
                android:textColor="@color/uvos_text_dim"
                android:textSize="10.5sp" />

            <LinearLayout
                android:id="@+id/launcher_apps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Кнопка перехода в Контрольный щиток (DESIGN.md §3.4) -->
        <Button
            android:id="@+id/open_shield"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/open_shield"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:letterSpacing="0.06"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/uvos_text_dim"
            android:textSize="11.5sp"
            android:text="@string/prototype_status" />
    </LinearLayout>
</ScrollView>
