<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uvos_background"
    android:orientation="vertical">

    <!-- Верхний статус-бар UnderVoltOS (с учётом выреза под камеру 34dp) -->
    <LinearLayout
        android:id="@+id/desktop_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="34dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/top_bar_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UVOS-CORE 2.0"
            android:textColor="@color/uvos_text_dim"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:fontFamily="monospace" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/top_bar_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/top_bar_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="82% ⚡"
            android:textColor="@color/uvos_text"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ГОРИЗОНТАЛЬНЫЙ ПАГИНАТОР ВСЕХ 4 РАБОЧИХ СТОЛОВ -->
    <com.uvos.dashboard.DesktopPagerView
        android:id="@+id/desktop_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

            <!-- ======================================================== -->
            <!-- СТОЛ 01: ПРИБОРНЫЙ СТОЛ (DASHBOARD) - 4 ВОЛЬТМЕТРА 2x2  -->
            <!-- ======================================================== -->
            <ScrollView
                android:id="@+id/desktop_1_dashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp">

                    <!-- Ряд 1: CPU (Загрузка процессора) + MEM (Оперативная память) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">

                        <!-- CPU -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="6dp">

                            <com.uvos.dashboard.GaugeView
                                android:id="@+id/gauge_cpu"
                                android:layout_width="match_parent"
                                android:layout_height="156dp"
                                custom:title="CPU" />

                            <TextView
                                android:id="@+id/val_cpu_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_tile"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="CPU: 42% • 8 ЯДЕР"
                                android:textColor="@color/uvos_text"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- MEM (в красной зоне с горящим красным светодиодом) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginStart="6dp">

                            <com.uvos.dashboard.GaugeView
                                android:id="@+id/gauge_mem"
                                android:layout_width="match_parent"
                                android:layout_height="156dp"
                                custom:title="MEM" />

                            <TextView
                                android:id="@+id/val_mem_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_tile"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="ОЗУ: 6.8 ГБ • 85%"
                                android:textColor="@color/uvos_red"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Ряд 2: BATT (Заряд батареи) + NET (Сетевой трафик) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="14dp">

                        <!-- BATT -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="6dp">

                            <com.uvos.dashboard.GaugeView
                                android:id="@+id/gauge_battery"
                                android:layout_width="match_parent"
                                android:layout_height="156dp"
                                custom:title="BATT" />

                            <TextView
                                android:id="@+id/val_battery_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_tile"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="АКБ: 82% • 4.12V"
                                android:textColor="@color/uvos_text"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- NET -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginStart="6dp">

                            <com.uvos.dashboard.GaugeView
                                android:id="@+id/gauge_net"
                                android:layout_width="match_parent"
                                android:layout_height="156dp"
                                custom:title="NET" />

                            <TextView
                                android:id="@+id/val_net_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_tile"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="СЕТЬ: 1.2 МБ/С"
                                android:textColor="@color/uvos_text"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Панель управления виджетами / добавление прибора -->
                    <LinearLayout
                        android:id="@+id/btn_add_gauge_widget"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tile_clickable"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ ДОБАВИТЬ ПРИБОР / ВИДЖЕТ"
                            android:textColor="@color/uvos_text"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <!-- Контейнер пользовательских виджетов / приборов на Столе 01 -->
                    <LinearLayout
                        android:id="@+id/custom_gauges_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Профиль ограничений -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_tile"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_title"
                            android:textColor="@color/uvos_text_dim"
                            android:textSize="10.5sp"
                            android:letterSpacing="0.08"
                            android:textStyle="bold" />

                        <com.uvos.dashboard.SegmentedControl
                            android:id="@+id/profile_selector"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/profile_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/uvos_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Суточный журнал попыток -->
                    <LinearLayout
                        android:id="@+id/card_daily_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_tile_clickable"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <com.uvos.dashboard.LampView
                            android:id="@+id/log_lamp_dot"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            custom:isLampOn="true" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ЖУРНАЛ ЗА СУТКИ"
                                android:textColor="@color/uvos_text_dim"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/log_blocked_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Telegram • Заряд батареи (ACTION_BATTERY)"
                                android:textColor="@color/uvos_text"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14 БЛОК."
                            android:textColor="@color/uvos_red"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Кнопка перехода в Аналоговый Сейф UVOS -->
                    <Button
                        android:id="@+id/btn_open_vault"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="🔒 АНАЛОГОВЫЙ СЕЙФ"
                        android:textColor="@color/uvos_text"
                        android:textSize="13sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold" />

                    <!-- Кнопка перехода в Контрольный щиток -->
                    <Button
                        android:id="@+id/open_shield"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="@string/open_shield"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/uvos_text_dim"
                        android:textSize="11sp"
                        android:text="@string/prototype_status" />
                </LinearLayout>
            </ScrollView>

            <!-- ======================================================== -->
            <!-- СТОЛ 02: ПРОСТОЙ РАБОЧИЙ СТОЛ (HOME) - ЧАСЫ И СЕТКА 4x4 -->
            <!-- ======================================================== -->
            <ScrollView
                android:id="@+id/desktop_2_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="16dp">

                    <!-- Индустриальные системные часы-виджет -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingTop="12dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:id="@+id/home_clock_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="19:58"
                            android:textColor="#FFFFFF"
                            android:textSize="46sp"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:id="@+id/home_clock_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="ПЯТНИЦА • 30 ОКТЯБРЯ 2026"
                            android:textColor="@color/uvos_text_dim"
                            android:textSize="11sp"
                            android:letterSpacing="0.08"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- СЕТКА ИКОНОК 4x4 (ДИНАМИЧЕСКИЙ РАБОЧИЙ СТОЛ С ПОДДЕРЖКОЙ РЕДАКТИРОВАНИЯ) -->
                    <LinearLayout
                        android:id="@+id/home_grid_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/home_row_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/home_row_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/home_row_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/home_row_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ======================================================== -->
            <!-- СТОЛ 03: МЕНЮ ПРИЛОЖЕНИЙ (СВАЙП ВПРАВО / APP DRAWER)    -->
            <!-- ======================================================== -->
            <ScrollView
                android:id="@+id/desktop_3_drawer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp">

                    <!-- Поисковая строка с подсказкой -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_search"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ПОИСК ПО ПАКЕТАМ И СЛУЖБАМ"
                            android:textColor="@color/uvos_text_dim"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.06" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="16dp"
                            android:background="@color/uvos_red" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="УСТАНОВЛЕННЫЕ ПРИЛОЖЕНИЯ (ЗАКРЫТАЯ ТЕРРИТОРИЯ)"
                        android:textColor="@color/uvos_text_dim"
                        android:textSize="10.5sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- Динамический список приложений из PackageManager -->
                    <LinearLayout
                        android:id="@+id/drawer_apps_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <!-- ======================================================== -->
            <!-- СТОЛ 04: МЕНЕДЖЕР ПРОЦЕССОВ (PROCESS MANAGER)           -->
            <!-- ======================================================== -->
            <ScrollView
                android:id="@+id/desktop_4_manager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp">

                    <!-- Верхняя сводка ресурсов (3 карточки) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Карточка 1: Активные -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4 / 28"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="АКТИВНЫХ"
                                android:textColor="@color/uvos_text_dim"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Карточка 2: ОЗУ -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6.8 ГБ"
                                android:textColor="@color/uvos_red"
                                android:textSize="14sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ОЗУ (85%)"
                                android:textColor="@color/uvos_text_dim"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Карточка 3: Каналы -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4 КАН."
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="СЕТЬ/ДАННЫЕ"
                                android:textColor="@color/uvos_text_dim"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Сегментный фильтр процессов -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_tile"
                        android:orientation="horizontal"
                        android:padding="2dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/manager_filter_active"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:background="@drawable/bg_button_primary"
                            android:text="АКТИВНЫЕ (4)"
                            android:textColor="#FFFFFF"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/manager_filter_access"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="С ДОСТУПОМ (3)"
                            android:textColor="@color/uvos_text_dim"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/manager_filter_isolated"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="ИЗОЛИРОВАНЫ"
                            android:textColor="@color/uvos_text_dim"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Список процессов с автовставляемыми значками метрик -->
                    <LinearLayout
                        android:id="@+id/manager_process_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Кнопка усыпления фоновых служб -->
                    <Button
                        android:id="@+id/btn_kill_all_services"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="УСЫПИТЬ ВСЕ ФОНОВЫЕ СЛУЖБЫ"
                        android:textColor="@color/uvos_text"
                        android:textSize="12sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>
    </com.uvos.dashboard.DesktopPagerView>

    <!-- ИНДИКАТОР ПАГИНАЦИИ (СТРОГО НАД ДОКОМ) -->
    <LinearLayout
        android:id="@+id/pagination_dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/dot_page_1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="3.5dp"
            android:background="@drawable/bg_tile" />

        <View
            android:id="@+id/dot_page_2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="3.5dp"
            android:background="@drawable/bg_tile" />

        <View
            android:id="@+id/dot_page_3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="3.5dp"
            android:background="@drawable/bg_tile" />

        <View
            android:id="@+id/dot_page_4"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="3.5dp"
            android:background="@drawable/bg_tile" />
    </LinearLayout>

    <!-- НИЖНИЙ БРОНИРОВАННЫЙ ДОК НА 4 СЛОТА -->
    <LinearLayout
        android:id="@+id/home_dock"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_dock"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Док: Телефон -->
        <ImageView
            android:id="@+id/dock_phone"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:src="@drawable/ic_sys_phone" />

        <!-- Док: Сообщения -->
        <ImageView
            android:id="@+id/dock_messages"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:src="@drawable/ic_sys_messages" />

        <!-- Док: Радар-сеть -->
        <ImageView
            android:id="@+id/dock_radar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:src="@drawable/ic_sys_radar" />

        <!-- Док: Щиток UVOS -->
        <ImageView
            android:id="@+id/dock_shield"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:src="@drawable/ic_sys_shield" />
    </LinearLayout>

</LinearLayout>
