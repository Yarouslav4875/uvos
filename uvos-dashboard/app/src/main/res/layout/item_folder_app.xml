<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp"
    android:background="@drawable/bg_quick_actions_item"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/folder_item_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_tile_clickable"
        android:padding="8dp" />

    <TextView
        android:id="@+id/folder_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Приложение"
        android:textColor="@color/uvos_text"
        android:textSize="10.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
