<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Никаких опасных разрешений: прототип честно демонстрирует принцип
         "закрытой территории" - данные берутся только из sticky-броадкаста
         батареи, который не требует разрешений. -->

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.UVOS">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ShieldActivity"
            android:exported="false" />
    </application>
</manifest>
