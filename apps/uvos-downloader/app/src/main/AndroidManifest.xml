<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DownloaderApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_downloader"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_downloader"
        android:supportsRtl="false"
        android:theme="@style/Theme.UVOSDownloader">

        <service
            android:name=".service.DownloadForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <activity
            android:name=".ui.main.DownloaderActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.UVOSDownloader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Intercept file download intents from browsers / links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-tar" />
            </intent-filter>
        </activity>
    </application>
</manifest>
